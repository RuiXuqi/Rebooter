fermiumbooter.toast.compatibilityWarnings.title=Rebooter: %d compact warnings
fermiumbooter.toast.compatibilityWarnings.description=Check the log for more info.

fermiumbooter.config.network=Network
fermiumbooter.config.network.versionOverride=Override Network Version
fermiumbooter.config.network.versionOverride.tooltip=Uses the configured network version instead of compat version.\nThis changes the version exposed through the mod container, not local mod compat checks.
fermiumbooter.config.network.version=Network Version
fermiumbooter.config.network.version.tooltip=Version exposed through the mod container when the network version override is enabled.
fermiumbooter.config.client=Client
fermiumbooter.config.client.hideWarningToast=Hide Compatibility Warning Toast
fermiumbooter.config.client.hideWarningToast.tooltip=Prevents the in-game toast that reports Rebooter compatibility warnings.
fermiumbooter.config.mixins=Mixins
fermiumbooter.config.mixins.ignoreCompatChecks=Ignore Mixin Config Compatibility Checks
fermiumbooter.config.mixins.ignoreCompatChecks.tooltip=Skips CompatHandling requirements when an annotated Mixin toggle is enabled.\nFailed compatibility checks will neither disable the Mixin nor produce warnings.
fermiumbooter.config.mixins.forceLoadConfigs=Force-Load Mixin Configs
fermiumbooter.config.mixins.forceLoadConfigs.tooltip=Mixin configuration resource names to register unconditionally in the early loading phase.\nA name also listed in removals remains disabled.
fermiumbooter.config.mixins.blockConfigs=Block Mixin Configs
fermiumbooter.config.mixins.blockConfigs.tooltip=Mixin configuration resource names to reject from both early and late loading.\nRemoval wins over forced additions, annotations, and API registrations with the same name.
fermiumbooter.config.discovery=Mod Discovery
fermiumbooter.config.discovery.overridePackageMappings=Override Package Mappings
fermiumbooter.config.discovery.overridePackageMappings.tooltip=Uses the configured package mappings instead of the built-in defaults.\nThe configured list is ignored while this stays disabled.
fermiumbooter.config.discovery.packageMappings=Package Mappings
fermiumbooter.config.discovery.packageMappings.tooltip=Fallback package prefixes for mod IDs that discovery does not report.\nA mod ID is considered present when any scanned JAR entry starts with its mapped prefix.\nFormat: package.name=modid. Dotted and slash-separated package names are accepted.\nMod IDs preserve their configured case; API and compatibility queries ignore case.\nApplies only when the package mappings override is on.
fermiumbooter.config.discovery.classScanAllowlist=Class Scan Allowlist
fermiumbooter.config.discovery.classScanAllowlist.tooltip=Package prefixes that remain eligible for discovery annotation scanning when normally filtered.\nApplies to @MixinConfig and Forge @Mod classes under bundled library packages.\nDotted and slash-separated package names are accepted.
fermiumbooter.config.cache=Discovery Cache
fermiumbooter.config.cache.enabled=Enable Discovery Cache
fermiumbooter.config.cache.enabled.tooltip=Caches JAR discovery results between launches.\nDisable to rescan every candidate JAR on every launch.
fermiumbooter.config.cache.verifyMode=Cache Verify Mode
fermiumbooter.config.cache.verifyMode.tooltip=Cache verification mode: always or auto.\nalways re-fingerprints every cached JAR; auto trusts unchanged file stamps.
fermiumbooter.config.diagnostics=Diagnostics
fermiumbooter.config.diagnostics.logStats=Log Discovery Statistics
fermiumbooter.config.diagnostics.logStats.tooltip=Logs JAR discovery timing statistics.
